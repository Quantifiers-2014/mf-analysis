# Copy this file to .env (same folder) and fill in your keys. Never share or commit .env.

# --- AI model for the "Ask the analyst" chat ---------------------------------------------
# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pick the model. Default for Gemini: gemini-3.8-flash
# ARBITRAGE_AGENT_MODEL=gemini-3.8-flash

# Optional: use Claude instead. Set the provider and the key.
# ARBITRAGE_AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional: any other OpenAI-compatible API (Groq, OpenRouter, Ollama...).
# ARBITRAGE_AGENT_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# ARBITRAGE_AGENT_MODEL=

# --- Langfuse tracing (optional; leave blank to switch off) ---------------------------------
# Keys come from your Langfuse project's settings (cloud.langfuse.com, or your own server).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
